rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    // Older accounts were created with a username-based placeholder email; newer ones
    // (and older ones that added an email) own a usernames/{name} entry instead. This looks
    // at the entry as it will be after the write, so changing username can claim the new
    // name and switch the profile over to it in one step.
    function ownsUsername(name) {
      return request.auth.token.email == name + '@users.nyc-burger-ranker.app'
        || (existsAfter(/databases/$(database)/documents/usernames/$(name))
          && getAfter(/databases/$(database)/documents/usernames/$(name)).data.uid == request.auth.uid);
    }

    // Profiles and saved lists. Signed-in users can read everyone's (to follow them
    // and see their lists) but can only change or delete their own.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        // The username must be one this account owns (usernames are unique).
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && ownsUsername(request.resource.data.usernameLower);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Which account owns each username. Anyone can check whether a name is taken.
    // A name never changes hands directly: only its owner can release it, and only once
    // their profile no longer uses it (they changed username or deleted their account).
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
          || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower != name);
    }

    // Leaderboard entries: one per user per city per category, written (or deleted) only by that user,
    // under their own username, with at most 10 spots. NYC entries (and older ones with no
    // city) are {uid}_{category}; other cities' are {uid}_{city}_{category}.
    function submissionIdFor(data) {
      return data.get('city', 'nyc') == 'nyc'
        ? request.auth.uid + '_' + data.category
        : request.auth.uid + '_' + data.city + '_' + data.category;
    }

    match /submissions/{submissionId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('city', 'nyc') in ['nyc', 'miami']
        && submissionId == submissionIdFor(request.resource.data)
        && request.resource.data.category in ['burgers', 'martinis', 'pizza']
        && request.resource.data.username is string
        && ownsUsername(request.resource.data.username.lower())
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 10
        && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Photos of spots on people's lists (see photoStore.js). Each account has 30 numbered
    // slots ({uid}_1 to {uid}_30), so nobody can fill the database. Photos can't be edited
    // once posted, and only the person who posted one can delete it.
    function isOwnPhotoSlot(photoId) {
      return request.auth != null
        && photoId.matches(request.auth.uid + '_([1-9]|[12][0-9]|30)');
    }

    function isJpeg(value, maxSize) {
      return value is string
        && value.size() <= maxSize
        && value.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }

    match /photos/{photoId} {
      allow read: if request.auth != null;
      allow create: if isOwnPhotoSlot(photoId)
        && request.resource.data.keys().hasOnly(['userId', 'username', 'category', 'placeId', 'placeName', 'thumb', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.username is string
        && ownsUsername(request.resource.data.username.lower())
        && request.resource.data.category in ['burgers', 'martinis', 'pizza']
        && request.resource.data.placeId is string
        && request.resource.data.placeId.matches('[A-Za-z0-9_-]{1,150}')
        && request.resource.data.placeName is string
        && request.resource.data.placeName.size() <= 200
        && isJpeg(request.resource.data.thumb, 60000)
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // The full-size picture for each photo, kept apart so lists of photos stay small.
    match /photoFiles/{photoId} {
      allow read: if request.auth != null;
      allow create: if isOwnPhotoSlot(photoId)
        && request.resource.data.keys().hasOnly(['userId', 'image'])
        && request.resource.data.userId == request.auth.uid
        && isJpeg(request.resource.data.image, 400000);
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Each account's profile photo: a small JPEG only that account can set or remove.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['userId', 'image', 'updatedAt'])
        && request.resource.data.userId == uid
        && isJpeg(request.resource.data.image, 40000)
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Booking pages for the Reserve button (see bookingStore.js), one per spot, shared by
    // everyone so each spot is looked up once. Only links to the big booking sites are
    // allowed, so nobody can point a Reserve button at a harmful page. An automatic lookup
    // never replaces a link someone added by hand.
    match /bookingLinks/{placeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && placeId.matches('[A-Za-z0-9_-]{1,150}')
        && request.resource.data.keys().hasOnly(['url', 'source', 'checkedAt', 'updatedBy'])
        && request.resource.data.url is string
        && (request.resource.data.url == ''
          || request.resource.data.url.matches('https://((www|widgets)[.])?((resy|opentable|exploretock|sevenrooms)[.]com|yelp[.]com/reservations)/[-A-Za-z0-9._~:/?#@!$&()*+,;=%]{0,400}'))
        && request.resource.data.source in ['auto', 'manual']
        && request.resource.data.checkedAt is string
        && request.resource.data.checkedAt.size() <= 40
        && request.resource.data.updatedBy == request.auth.uid
        && (resource == null || resource.data.source == 'auto' || request.resource.data.source == 'manual');
      allow delete: if false;
    }
  }
}
