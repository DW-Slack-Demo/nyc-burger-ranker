rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles and saved lists. Signed-in users can read everyone's (to follow them
    // and see their lists) but can only change their own.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        // The username must be the one the account was created with (it is unique).
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.auth.token.email == request.resource.data.usernameLower + '@users.nyc-burger-ranker.app';
      allow delete: if false;
    }

    // Leaderboard entries: one per user per category, written only by that user.
    match /submissions/{submissionId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && submissionId == request.auth.uid + '_' + request.resource.data.category
        && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if false;
    }
  }
}
