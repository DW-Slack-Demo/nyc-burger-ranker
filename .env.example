# Copy to .env and fill in. Find it in the Firebase console under Project settings > General > Your apps.
VITE_FIREBASE_API_KEY=

# Address of the AI Finder server in ai-search/ (see README). For local development run
# `npm run dev` in ai-search/ and use http://localhost:8787. Leave blank to turn AI search off.
VITE_AI_SEARCH_URL=
